# Export these variables in your shell or hosting service; Django does not load this file.
DJANGO_ENV=development
# Production requires a new random secret, explicit hosts, PostgreSQL, Redis and SMTP.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
REDIS_URL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
SUPPORT_EMAIL=
# Only enable behind a trusted proxy that strips/sets X-Forwarded-Proto.
DJANGO_TRUST_PROXY=false
# Only select a header if your trusted proxy overwrites it on every request.
RATELIMIT_IP_META_KEY=REMOTE_ADDR
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
